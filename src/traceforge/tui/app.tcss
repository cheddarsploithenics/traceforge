#tabs {
    height: 1fr;
}

#overview {
    align: center top;
}

#main {
    width: 80;
    height: auto;
}

#intro {
    padding: 0 1 1 1;
    color: $text-muted;
}

.panel {
    border: round $primary;
    padding: 1 2;
    height: auto;
}

.panel.-ok {
    border: round $success;
}

.panel.-error {
    border: round $error;
}

#scan-list {
    height: 1fr;
    min-height: 6;
    border: round $primary;
}

#scan-detail {
    padding: 0 2;
}

#scan-results {
    height: 2fr;
    min-height: 6;
    border: round $primary;
}
